# Copy to samconfig.toml (gitignored) after `sam deploy --guided`, or pass flags manually.
version = 0.1

[default.deploy.parameters]
stack_name = "thermosentinel-api"
resolve_s3 = true
capabilities = "CAPABILITY_IAM"
region = "us-east-1"
confirm_changeset = true
parameter_overrides = "TursoDatabaseUrl=\"\" TursoAuthToken=\"\" RedisUrl=\"\""
