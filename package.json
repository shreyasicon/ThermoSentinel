{
  "name": "my-project",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/free-dev-ports.mjs && concurrently -n app,fog,sim -c blue,magenta,green \"npm run dev:next\" \"npm run fog\" \"npm run simulator\"",
    "dev:next": "next dev",
    "dev:all": "npm run dev",
    "dev:all:http": "npm run dev",
    "predev:iot": "tsx scripts/verify-iot-core.ts",
    "iot:verify": "tsx scripts/verify-iot-core.ts",
    "dev:iot": "node scripts/free-dev-ports.mjs && concurrently -n app,fog,sim -c blue,magenta,green \"npm run dev:next\" \"npm run fog:mqtt\" \"npm run simulator:mqtt\"",
    "dev:pipeline": "npm run dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "simulator": "cross-env SENSOR_TRANSPORT=http tsx services/sensor-simulator/index.ts",
    "simulator:http": "cross-env SENSOR_TRANSPORT=http tsx services/sensor-simulator/index.ts",
    "simulator:mqtt": "cross-env SENSOR_TRANSPORT=mqtt tsx services/sensor-simulator/index.ts",
    "fog": "cross-env FOG_PORT=4000 FOG_INPUT_MODE=http tsx services/fog-node/index.ts",
    "fog:http": "cross-env FOG_PORT=4000 FOG_INPUT_MODE=http tsx services/fog-node/index.ts",
    "fog:mqtt": "cross-env FOG_PORT=4000 FOG_INPUT_MODE=mqtt tsx services/fog-node/index.ts",
    "worker": "tsx scripts/ingest-worker.ts",
    "deploy:aws": "node scripts/deploy.mjs",
    "build:amplify": "node scripts/build-amplify.mjs",
    "zip:out": "node scripts/zip-static-out.mjs",
    "build:lambda": "node scripts/build-lambda.mjs",
    "build:all": "npm run lint && npm run build && npm run build:lambda && npm run build:amplify",
    "deploy:api": "node scripts/build-lambda.mjs && node scripts/cfn-deploy-api.mjs",
    "stack:env": "node scripts/thermo-stack-env.mjs",
    "amplify:env": "node scripts/amplify-console-env.mjs",
    "deploy:sam": "node scripts/build-lambda.mjs && node scripts/sam-deploy.mjs",
    "deploy:all": "npm run deploy:api && npm run deploy:aws",
    "ship": "npm run build:all && npm run deploy:api && npm run deploy:aws",
    "iot:deploy": "aws cloudformation deploy --template-file infra/iot-core/template.yaml --stack-name thermosentinel-iot --no-fail-on-empty-changeset",
    "iot:provision": "node scripts/iot-provision.mjs",
    "iot:cert-id": "node scripts/iot-cert-id.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1024.0",
    "@aws-sdk/client-sns": "^3.1024.0",
    "@aws-sdk/client-sqs": "^3.1024.0",
    "@aws-sdk/lib-dynamodb": "^3.1024.0",
    "@libsql/client": "^0.14.0",
    "@vercel/analytics": "1.6.1",
    "autoprefixer": "^10.4.20",
    "bullmq": "^5.34.5",
    "dotenv": "^17.4.0",
    "ioredis": "^5.4.1",
    "lucide-react": "^0.564.0",
    "mqtt": "^5.10.1",
    "next": "16.1.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "2.15.0"
  },
  "devDependencies": {
    "@aws-sdk/client-cloudformation": "^3.1024.0",
    "@aws-sdk/client-iot": "^3.1024.0",
    "@eslint/eslintrc": "^3.2.0",
    "@tailwindcss/postcss": "^4.2.0",
    "@types/aws-lambda": "^8.10.147",
    "@types/node": "^22",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "archiver": "^7.0.1",
    "concurrently": "^9.1.0",
    "cross-env": "^10.0.0",
    "esbuild": "^0.25.0",
    "eslint": "^9.39.3",
    "eslint-config-next": "^16.1.6",
    "postcss": "^8.5",
    "tailwindcss": "^4.2.0",
    "tsx": "^4.19.2",
    "tw-animate-css": "1.3.3",
    "typescript": "5.7.3"
  }
}
