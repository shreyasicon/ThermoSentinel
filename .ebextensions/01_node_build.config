# Ensure devDependencies (TypeScript, etc.) install on the instance, then build Next.js
# before the app is promoted to /var/app/current.
option_settings:
  aws:elasticbeanstalk:application:environment:
    NPM_USE_PRODUCTION: 'false'
  aws:elasticbeanstalk:command:
    Timeout: '1800'

container_commands:
  01_next_build:
    command: npm run build
    leader_only: true
