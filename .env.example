# Optional: persist sensor readings in production (Turso/libSQL).
# Create a DB at https://turso.tech and set these to enable cloud persistence.
# TURSO_DATABASE_URL=libsql://your-db-name-your-org.turso.io
# TURSO_AUTH_TOKEN=your-token

# Fog HTTP port (do not reuse Next.js PORT=3000 — fog uses FOG_PORT, default 4000)
# FOG_PORT=4000

# Fog node: URL the fog node uses to POST readings to this app (default: http://localhost:3000/api/ingest).
# Match this to wherever ingest should go: local Next (npm run dev) or API Gateway + Lambda URL + /api/ingest.
# CLOUD_URL=http://127.0.0.1:3000/api/ingest
# If you expose local Next via ngrok (Forwarding https://YOUR_SUBDOMAIN.ngrok-free.dev -> localhost:3000), use:
# CLOUD_URL=https://YOUR_SUBDOMAIN.ngrok-free.dev/api/ingest
# CLOUD_URL=https://xxxx.execute-api.region.amazonaws.com/prod/api/ingest

# Ingest queue: `next dev` processes POST /api/ingest in-process (same memory as GET /api/sensors/*).
# If you set REDIS_URL and need Bull ingest during dev, use: INGEST_USE_REDIS_IN_DEV=true (and run npm run worker).
# INGEST_USE_REDIS_IN_DEV=true

# --- Dashboard API target (browser; toggled in UI: Local API vs Lambda) ---
# Lambda / API Gateway base URL only (no trailing slash, no /api path suffix — paths are appended).
# Required for production static hosting; optional in `next dev` (built-in dev fallback matches the sample stack).
# NEXT_PUBLIC_LAMBDA_API_URL=https://xxxx.execute-api.region.amazonaws.com/prod
# Optional override for "Local API" when the UI is hosted (e.g. Amplify) and Next runs on your PC:
# — HTTPS only from an https://*.amplifyapp.com page: browsers block http://127.0.0.1 (mixed content).
# Point at an HTTPS tunnel to the machine running `npm run dev` (same origin as your API + /api/fog/status).
# NEXT_PUBLIC_LOCAL_API_URL=https://YOUR-SUBDOMAIN.ngrok-free.dev
# NEXT_PUBLIC_FOG_STATUS_URL is optional if it matches NEXT_PUBLIC_LOCAL_API_URL + /api/fog/status
# Legacy: single remote API (same as Lambda base if you only had one env before)
# NEXT_PUBLIC_API_URL=https://xxxx.execute-api.region.amazonaws.com/prod
# CORS for /api/* when the static UI calls your local Next (comma-separated origins):
# ALLOWED_API_ORIGINS=https://main.dx55a7yx23a8.amplifyapp.com,http://localhost:3000

# --- AWS IoT Core + MQTT (copy lines you need into `.env`; keep secrets out of git) ---
#
# Your account (example — IoT → Settings: device data endpoint; region us-east-1):
#   Endpoint: a1g9hxy6qv5nkz-ats.iot.us-east-1.amazonaws.com
# Things (Manage → Things): mock-sensor-001, thermosentinel-fog
#
# Certificates: AWS never lets you re-download an existing private key from the console. Options:
# (A) Automated (recommended): AWS CLI configured (`aws sts get-cidentity`). From repo root:
#       npm run iot:deploy && npm run iot:provision
#     This creates NEW key pairs via API, attaches policies/Things, writes certs/sensor/ and certs/fog/,
#     downloads Amazon Root CA 1, and writes .env.iot.generated — merge uncommented lines into .env.local.
# (B) Manual: create/activate a certificate in IoT console once and download the bundle immediately;
#     place PEMs under ./certs/ (gitignored). See docs/AWS_IOT_DEPLOY.md.
# You may use one cert + policy for BOTH client IDs, or two cert pairs (two terminals) — docs/AWS_IOT_CORE.md.
#
# The MQTT test client in the AWS console uses its own client ID (e.g. iotconsole-…) — do not put that in .env.
# This app uses SIMULATOR_MQTT_CLIENT_ID / FOG_MQTT_CLIENT_ID with mqtt.js (MQTT 3.1.1); IoT Core accepts it.
#
# SENSOR_TRANSPORT=mqtt
# FOG_INPUT_MODE=mqtt
# MQTT_BROKER_URL=mqtts://a1g9hxy6qv5nkz-ats.iot.us-east-1.amazonaws.com:8883
# AWS_REGION=us-east-1
# Option A — one cert pair for both (uncomment three lines):
# AWS_IOT_CA_PATH=./certs/AmazonRootCA1.pem
# AWS_IOT_CERT_PATH=./certs/device.pem.crt
# AWS_IOT_KEY_PATH=./certs/private.pem.key
#
# Option B — separate edge vs fog files in ./certs/ (code maps EDGE_* / FOG_* per process):
# EDGE_AWS_IOT_CA_PATH=./certs/AmazonRootCA1edge.pem
# EDGE_AWS_IOT_CA_EXTRA_PATH=./certs/AmazonRootCA3edge.pem
# EDGE_AWS_IOT_CERT_PATH=./certs/edgemqtt.crt
# EDGE_AWS_IOT_KEY_PATH=./certs/privateedge.key
# FOG_AWS_IOT_CA_PATH=./certs/AmazonRootCA1fog.pem
# FOG_AWS_IOT_CA_EXTRA_PATH=./certs/AmazonRootCA3fog.pem
# FOG_AWS_IOT_CERT_PATH=./certs/fogmqtt.crt
# FOG_AWS_IOT_KEY_PATH=./certs/privatefog.key
# Option C — `npm run iot:provision` output (sensor + fog subfolders):
# EDGE_AWS_IOT_CERT_PATH=./certs/sensor/certificate.pem.crt
# EDGE_AWS_IOT_KEY_PATH=./certs/sensor/private.pem.key
# FOG_AWS_IOT_CERT_PATH=./certs/fog/certificate.pem.crt
# FOG_AWS_IOT_KEY_PATH=./certs/fog/private.pem.key
# EDGE_AWS_IOT_CA_PATH=./certs/AmazonRootCA1.pem
# FOG_AWS_IOT_CA_PATH=./certs/AmazonRootCA1.pem
# SIMULATOR_MQTT_CLIENT_ID=mock-sensor-001
# FOG_MQTT_CLIENT_ID=thermosentinel-fog
# MQTT_TOPIC_MODE=iot
# MQTT_DATA_TOPIC=sensors/mock-sensor-001/data
# MQTT_TOPIC_FILTER=sensors/#
# MQTT_FLUSH_MS=2000
# Optional: hierarchical topics — MQTT_TOPIC_MODE=library, MQTT_TOPIC_ROOT=library/sensors, MQTT_TOPIC_FILTER=library/sensors/#
# MQTT_TOPIC_ROOT=library/sensors
#
# `npm run dev:iot` runs preflight `npm run iot:verify` (mqtts connect for EDGE then FOG). Override:
# IOT_VERIFY_TIMEOUT_MS=30000
# SKIP_IOT_VERIFY=1

# Fog → AWS SQS (stack output IngestQueueUrl; same JSON as HTTP ingest)
# FOG_SQS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/ACCOUNT/thermosentinel-api-ingest
# AWS_REGION=us-east-1
# IAM: sqs:SendMessage (see docs/DEPLOY_SQS_PIPELINE.md)
# Optional: CloudFormation queue policy for this principal (cross-account / explicit)
# FOG_SENDER_PRINCIPAL_ARN=arn:aws:iam::ACCOUNT:user/your-user
# After deploy: npm run stack:env  →  deploy/thermosentinel-api.env.generated (FOG_SQS_QUEUE_URL, CLOUD_URL, NEXT_PUBLIC_LAMBDA_API_URL)

# Fog → optional MQTT republish (defaults to same broker as MQTT_BROKER_URL)
# FOG_MQTT_PUBLISH=true
# MQTT_PUBLISH_BROKER_URL=mqtts://a1g9hxy6qv5nkz-ats.iot.us-east-1.amazonaws.com:8883
# MQTT_TO_CLOUD_TOPIC=fog/out/envelopes

# Details: docs/AWS_IOT_CORE.md — optional PEM aliases: MQTT_CA_PATH, MQTT_CERT_PATH, MQTT_KEY_PATH

# CORS if the browser calls fog directly (match the dashboard origin — ngrok URL if you use a tunnel)
# FOG_CORS_ORIGIN=http://localhost:3000
# FOG_CORS_ORIGIN=https://YOUR_SUBDOMAIN.ngrok-free.dev

# Next.js: proxy target for GET /api/fog/status → fog GET /status
# FOG_STATUS_URL=http://127.0.0.1:4000/status

# Static hosting: direct fog status URL (Amplify has no /api/fog route)
# NEXT_PUBLIC_FOG_STATUS_URL=http://127.0.0.1:4000/status

# --- Deploy API stack (Lambda + HTTP API + SQS): prefer SAM-free path ---
# npm run deploy:api   (CloudFormation + AWS CLI; see infra/cfn/thermosentinel-api.yaml)
# Optional: S3 bucket for Lambda zip (otherwise auto-named from account/region)
# API_ARTIFACTS_BUCKET=your-globally-unique-bucket-name
# Optional stack name (default thermosentinel-api)
# THERMO_API_STACK_NAME=thermosentinel-api
# CRITICAL alerts: set before deploy:api — SNS email subscription (confirm in inbox after deploy)
# OPS_ALERT_EMAIL=you@example.com
# Local Next.js reading same DynamoDB as Lambda (AWS creds required).
# By default `next dev` ignores this and uses in-memory store so local fog/simulator data shows up.
# Set to opt in: DYNAMODB from dev + stack table
# ALLOW_DYNAMODB_IN_NEXT_DEV=true
# DYNAMODB_READINGS_TABLE=thermosentinel-api-readings
# CRITICAL_TEMP_CELSIUS=35
# CRITICAL_SMOKE_INDEX=70
# --- Or use AWS SAM CLI (npm run deploy:sam) if sam is not on PATH ---
# SAM_CLI_PATH=E:\AWS SAM\bin\sam.cmd
